# Copy to .env and fill in. .env is gitignored. Never commit secrets.
# Precedence: configs/base.yaml < configs/<mode>/*.yaml < environment / .env
# Nested settings use a double underscore: QP_DB__HOST -> settings.db.host

# Mode: backtest | paper | live (default: paper). Live also needs QP_LIVE_TRADING and an
# approved_live promotion record; setting mode alone arms nothing.
# QP_MODE=paper

QP_DB__HOST=localhost
QP_DB__PORT=5433
QP_DB__NAME=qp
QP_DB__USER=qp
QP_DB__PASSWORD=change-me

# QP_LAKE__ROOT=data/lake

# Telegram notifier (optional). Leave empty to log notifications instead.
# Data sources (phase 2). Keys only here or in the process environment, never in YAML.
# TCMB EVDS 3: evds3.tcmb.gov.tr -> Benim Sayfam -> Profilim -> API Key Kopyala
# QP_SOURCES__EVDS__API_KEY=
# FRED: fredaccount.stlouisfed.org -> API Keys
# QP_SOURCES__FRED__API_KEY=
# Which TCMB rate values FX positions/cash: forex_buying (default) | forex_selling | banknote_*
# QP_SOURCES__TCMB__RATE_KIND=forex_buying

# Read-only assistant (phase 9). Off without a key; with one, questions and the portfolio
# figures the tools return are sent to Anthropic's API.
# QP_ASSISTANT__API_KEY=

# QP_TELEGRAM__BOT_TOKEN=
# QP_TELEGRAM__CHAT_ID=

# QP_LOG__LEVEL=INFO
# QP_LOG__JSON=true
